<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>orchestra</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!--
	  Export compliance, answered once here so every upload skips the
	  questionnaire: the app's only cryptography is what the OS provides
	  (ATS/TLS where used, the Keychain, and traffic inside the user's own
	  WireGuard tailnet — WireGuard's crypto belongs to Tailscale's app, not
	  this one). That is the textbook "exempt" case.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
	  IBM Plex Mono — the machine voice of the board, bundled rather than
	  approximated with SF Mono. FOUR faces and no more: `UX.md` §9.3 resolves
	  the mono ramp from `\.legibilityWeight`, so Regular/SemiBold carry normal
	  legibility and Medium/Bold carry the system Bold Text setting. No italic —
	  neither the app nor the desktop CSS ever asks for one — and none of the
	  other six Plex weights, because each unused `.ttf` is ~170 KB of download
	  nothing renders.

	  These are FILENAMES. What `UIFont(name:)` and `Font.custom` want is the
	  PostScript name, and for two of these four it is NOT the filename:
	  `IBMPlexMono-Medm` and `IBMPlexMono-SmBld`. `UI/Typography.swift` holds
	  those, and a mismatch substitutes silently rather than failing.

	  The `.ttf`s and `OFL.txt` live in `App/Fonts/`, which is inside a
	  file-system-synchronised group — no `.pbxproj` edit registers them, and the
	  copy phase flattens the folder, so the paths here are bare basenames.
	  `OFL.txt` ships in the bundle beside them because the SIL Open Font
	  License requires the licence to travel with the font.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
		<string>IBMPlexMono-SemiBold.ttf</string>
		<string>IBMPlexMono-Bold.ttf</string>
	</array>

	<!--
	  `remote-notification` so a `content-available: 1` push (every one
	  `notify.compose` sends sets it) can wake the app to refresh its cached
	  board while backgrounded. It is the only background mode this app claims;
	  it does not run code on a timer and does not need `fetch`.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!--
	  App Transport Security — ADR 0013.

	  The server speaks PLAIN HTTP over the tailnet, deliberately: WireGuard
	  already gives mutual authentication and confidentiality between devices,
	  so TLS on top would secure a channel that is already secure, in exchange
	  for a certificate lifecycle and pinning logic that fails closed and
	  strands the user. Security comes from Tailscale, the per-device bearer
	  token, and a server that binds loopback until you opt in.

	  So an ATS exception is needed, and it is SCOPED. `NSAllowsArbitraryLoads`
	  is never set: it would disable ATS process-wide rather than for one host,
	  and this dictionary is meant to say what is actually intended.

	  `NSAllowsLocalNetworking` does NOT help, and this is the trap ADR 0013
	  names: it covers `.local` and link-local, not the `100.64/10` CGNAT range
	  Tailscale hands out.

	  ONE entry: `ts.net` with subdomains, which covers every tailnet's
	  MagicDNS names — and since 2026-08-04 the MagicDNS name is what the
	  server ADVERTISES (`pairing.advertised` upgrades a bound tailnet IP to
	  the name in the QR, the manual fields and the claim's server facts).
	  There used to be a second, per-tailnet entry pinning the author's raw
	  tailnet IP, because ATS domain exceptions were measured to apply to
	  IP-literal keys on iOS 26 and the QR used to hand the phone the IP.
	  A store-distributed build cannot carry one user's IP, so the IP entry is
	  gone with the need for it. A tailnet with MagicDNS switched OFF still
	  pairs by IP and the board will not load on a store build — the
	  connection error names the address it refused; switching MagicDNS on
	  (Tailscale's default) is the fix.

	  Loopback needs no entry: ATS permits plain HTTP to 127.0.0.1, which is
	  what keeps the simulator rehearsal flow working.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<key>NSCameraUsageDescription</key>
	<string>orchestra scans the pairing code shown on your Mac.</string>
	<!--
	  Required or the FIRST `.deviceOwnerAuthentication` evaluation crashes the
	  app on a Face ID device. It gates the paired board behind Face ID / Touch
	  ID / passcode (see `App/BiometricGate.swift`). Passcode fallback needs no
	  key; only Face ID does.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>orchestra uses Face ID to unlock the fleet on this phone.</string>
	<!--
	  Included DEFENSIVELY. Whether iOS's local-network gate fires for a
	  `utun`-routed 100.64/10 destination is unverified (IOS-APP.md §11 lists it
	  as a day-one empirical task). Including the key costs one plist entry;
	  omitting it and being wrong costs a silent connection failure with no
	  diagnosable cause.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>orchestra connects to your Mac over your Tailscale network.</string>

	<!--
	  The scheme the pairing QR uses: `orc://p?h=<host>[&p=<port>]&c=<code>`.
	  Registered now so a scan from the system camera can hand the ticket
	  straight to the app later; the in-app scanner does not need it.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>sh.orchestra.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>orc</string>
				<string>orchestra</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
